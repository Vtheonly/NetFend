{
  "general": {
    "interface": null,
    "dry_run": false,
    "log_level": "INFO"
  },
  "firewall": {
    "enabled": true,
    "profile": "standard",
    "new_conn_rate_per_s": 50,
    "new_conn_burst": 100,
    "icmp_rate_per_s": 20,
    "strict_allowed_tcp_ports": [],
    "strict_allowed_udp_ports": [
      53,
      67,
      68
    ]
  },
  "hardening": {
    "enabled": true,
    "rp_filter": "strict",
    "restore_on_stop": true
  },
  "ipv6": {
    "enabled": true,
    "ra_guard": "auto",
    "detect_ra_conflicts": true,
    "ra_conflict_window_s": 60,
    "ra_conflict_max_sources": 1,
    "ra_conflict_cooldown_s": 300
  },
  "arp": {
    "gateway_confirmations": 2,
    "gateway_confirm_window_s": 60,
    "old_gw_silence_s": 120,
    "gateway_change_cooldown_s": 300,
    "oscillation_window_s": 120,
    "oscillation_min_transitions": 6,
    "corrective_arp_enabled": true,
    "corrective_arp_max": 5,
    "corrective_arp_cooldown_s": 60,
    "corrective_sustain_window_s": 12,
    "corrective_sustain_interval_s": 5,
    "corrective_packets_per_minute": 30
  },
  "dhcp": {
    "learn_observations": 2,
    "drop_override_targets": true
  },
  "dns": {
    "hijack_check": true,
    "public_resolvers": [
      "1.1.1.1",
      "9.9.9.9"
    ]
  },
  "dashboard": {
    "enabled": true,
    "bind": "127.0.0.1",
    "port": 8787,
    "allow_local_readonly": true
  },
  "wifi": {
    "enabled": true,
    "poll_interval_s": 10,
    "disconnect_count": 3,
    "disconnect_window_s": 300,
    "weak_signal_rssi": -80,
    "supplicant_monitor": true,
    "supplicant_poll_s": 5,
    "deauth_threshold": 4,
    "deauth_window_s": 180,
    "watcher_poll_s": 10,
    "watcher_journal_poll_s": 5,
    "watcher_heartbeat_s": 60,
    "evidence_max_bytes": 5000000,
    "abtest_profile": null,
    "abtest_ssid": null,
    "abtest_cycles": 2,
    "abtest_dwell_s": 300,
    "abtest_connect_timeout_s": 90,
    "abtest_probe_s": 5,
    "abtest_anonymize_hostname": true
  }
}
